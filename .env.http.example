# Opcional: copiar a .env.local para personalizar la API de npm run dev.
# npm run dev fuerza HTTP en http://localhost:5173 (puerto estricto).
# npm run demo fuerza mocks en http://localhost:5174 sin requerir API.
# Backend ADMIN_FRONTEND_URL exacto: http://localhost:5173.
# Navegador localhost compatible con cookies Secure/HttpOnly/SameSite.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Selección para build; no cambia el transporte de dev/demo.
VITE_SERVICE_MODE=http
