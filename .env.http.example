# Local development transport. Copy to .env.local once the provider stack is ready.
# Start Vite with: npm run dev -- --host localhost --port 5173 --strictPort
# Required exact backend ADMIN_FRONTEND_URL: http://localhost:5173
# localhost-compatible browser required; preserve Secure/HttpOnly/SameSite cookies.
VITE_SERVICE_MODE=http
VITE_API_BASE_URL=http://localhost:3000/api/v1
