# npm run dev: HTTP en localhost:5173; npm run demo: mocks en localhost:5174.
# Ambos fijan su transporte, aunque VITE_SERVICE_MODE heredado diga lo contrario.
# URL opcional para DEV; si falta usa http://localhost:3000/api/v1.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Solo build o Vite sin modo explícito usan esta selección genérica.
VITE_SERVICE_MODE=mock
# Clave pública para Maps JavaScript API y Places API (New).
# Restringir por HTTP referrer y por API en Google Cloud.
# VITE_GOOGLE_MAPS_API_KEY=
